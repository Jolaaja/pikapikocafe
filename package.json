{
  "name": "pika-piko-cafe",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n css,vite \"npm:watch:css\" \"vite\"",
    "watch:css": "tailwindcss -i ./tailwind.input.css -o ./tailwind.css --watch",
    "build:css": "tailwindcss -i ./tailwind.input.css -o ./tailwind.css --minify",
    "prebuild": "node scripts/generate-menu-poster.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:css && npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/cli": "^4.1.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
